# Clave de OpenAI para TTS de alta fidelidad (tts-1, voz 'nova' o 'shimmer') y Whisper STT
EXPO_PUBLIC_OPENAI_API_KEY=

# Clave de Groq para Whisper STT ultra-rápido (whisper-large-v3-turbo)
EXPO_PUBLIC_GROQ_API_KEY=

# Clave de OpenRouteService para geocodificación y cálculo de rutas vehiculares en vivo
EXPO_PUBLIC_ORS_API_KEY=
