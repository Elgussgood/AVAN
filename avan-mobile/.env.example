# ============================================================================
# VARIABLES DE ENTORNO PÚBLICAS PARA AVAN (EXPO MOBILE)
# ============================================================================

# 1. Servicios de Voz Humana Natural (TTS de Alta Fidelidad)
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=

# 2. Reconocimiento de Voz Ultra-rápido (STT Whisper con Zero-Persistence)
EXPO_PUBLIC_GROQ_API_KEY=

# 3. Ruteo Vehicular y Geocodificación en Tiempo Real (OpenRouteService)
EXPO_PUBLIC_ORS_API_KEY=

# 4. Persistencia en la Nube y Lugares Frecuentes (Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 5. (Opcional) Capas de Mapas de Alta Definición sin Marca de Agua (CartoDB)
EXPO_PUBLIC_CARTO_API_KEY=

# 6. Google AI (Gemini 2.5 Flash) - NLU con Function Calling (Fase 5)
#    Clave en https://aistudio.google.com/apikey (restringir a Generative Language API)
EXPO_PUBLIC_GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-2.5-flash)
EXPO_PUBLIC_GEMINI_MODEL=

# 7. Google Maps Platform - Geocoding + Directions con trafico en vivo (Fase 5)
#    Habilitar: Geocoding API, Places API, Directions API. Restringir por API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
