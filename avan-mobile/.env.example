# ============================================================================
# VARIABLES DE ENTORNO PÚBLICAS PARA AVAN (EXPO MOBILE)
# ============================================================================

# 1. Servicios de Voz Humana Natural (TTS de Alta Fidelidad)
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=

# 2. Reconocimiento de Voz Ultra-rápido (STT Whisper con Zero-Persistence)
EXPO_PUBLIC_GROQ_API_KEY=

# 3. Ruteo Vehicular y Geocodificación en Tiempo Real (OpenRouteService)
EXPO_PUBLIC_ORS_API_KEY=

# 4. Persistencia en la Nube y Lugares Frecuentes (Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 5. (Opcional) Capas de Mapas de Alta Definición sin Marca de Agua (CartoDB)
EXPO_PUBLIC_CARTO_API_KEY=
